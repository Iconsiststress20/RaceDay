@model RaceDay.Web.Models.ResultViewModel

@{
    ViewData["Title"] = "Edit Result";
}

<h2>Edit Race Result</h2>

<form asp-controller="Results" asp-action="Edit" method="post">
    @Html.AntiForgeryToken()

    <input type="hidden" asp-for="ResultID" />

    <div class="mb-3">
        <label class="form-label">Finish Time</label>
        <input asp-for="FinishTime"
               type="time"
               step="1"
               class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Overall Position</label>
        <input asp-for="OverallPosition"
               type="number"
               min="1"
               class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Category Position</label>
        <input asp-for="CategoryPosition"
               type="number"
               min="1"
               class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Points</label>
        <input asp-for="Points"
               type="number"
               min="0"
               class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Remarks</label>
        <textarea asp-for="Remarks"
                  class="form-control"
                  rows="3"></textarea>
    </div>

    <button type="submit" class="btn btn-primary">
        Save Changes
    </button>

    <a asp-controller="Results"
       asp-action="Index"
       class="btn btn-secondary">
        Cancel
    </a>
</form>

