@model RaceDay.Web.Models.EventCategoryViewModel

@{
    ViewData["Title"] = "Create Category";
}

<div class="container mt-4">
    <h2>Create Event Category</h2>

    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly"
             class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="CategoryName" class="form-label"></label>
            <input asp-for="CategoryName" class="form-control" />
            <span asp-validation-for="CategoryName"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Description" class="form-label"></label>
            <textarea asp-for="Description"
                      class="form-control"></textarea>
        </div>

        <div class="mb-3">
            <label asp-for="DistanceKM" class="form-label"></label>
            <input asp-for="DistanceKM"
                   type="number"
                   step="0.1"
                   class="form-control" />
            <span asp-validation-for="DistanceKM"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="MinAge" class="form-label"></label>
            <input asp-for="MinAge" type="number" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="MaxAge" class="form-label"></label>
            <input asp-for="MaxAge" type="number" class="form-control" />
            <span asp-validation-for="MaxAge"
                  class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-warning">
            Save Category
        </button>

        <a asp-action="Index" class="btn btn-secondary">
            Cancel
        </a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}