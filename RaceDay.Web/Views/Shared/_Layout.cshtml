@using Microsoft.AspNetCore.Http

@{
    var userRole = Context.Session.GetString("UserRole");
    var userName = Context.Session.GetString("UserName") ?? "User";
    var isLoggedIn = !string.IsNullOrEmpty(userRole);
    var userInitial = !string.IsNullOrWhiteSpace(userName)
        ? userName.Substring(0, 1).ToUpper()
        : "U";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - RaceDay</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
            :root {
                --race-navy: #071225;
                --race-dark: #030914;
                --race-blue: #142542;
                --race-orange: #ff7417;
                --race-orange-light: #ff923d;
                --race-white: #f8fafc;
                --race-muted: #aab6c8;
            }

            body {
                background: radial-gradient(ellipse at 50% 0%, #142642 0%, transparent 55%), linear-gradient(145deg, var(--race-dark), var(--race-navy));
                color: var(--race-white);
                font-family: "Segoe UI", Arial, sans-serif;
                min-height: 100vh;
                display: flex;
                flex-direction: column;
            }

            /* NAVIGATION */

            .raceday-navbar {
                background: rgba(3, 9, 20, .97);
                border-bottom: 2px solid var(--race-orange);
                padding: 13px 0;
                box-shadow: 0 5px 25px rgba(0,0,0,.4);
            }

            .navbar-brand {
                display: flex;
                align-items: center;
                gap: 10px;
                color: white !important;
                font-size: 27px;
                font-weight: 900;
                font-style: italic;
                letter-spacing: 1px;
            }

            .raceday-symbol {
                display: inline-flex;
                align-items: center;
                gap: 3px;
            }

            .raceday-checker {
                width: 23px;
                height: 23px;
                background: repeating-conic-gradient( #fff 0% 25%, transparent 0% 50% ) 0 0 / 11px 11px;
                transform: skew(-12deg);
            }

            .raceday-r {
                color: var(--race-orange);
                font-size: 39px;
                font-weight: 1000;
                line-height: 1;
                transform: skew(-12deg);
            }

            .raceday-wordmark {
                line-height: 1;
            }

                .raceday-wordmark span {
                    color: var(--race-orange);
                }

            .raceday-tagline {
                display: block;
                color: #b8c4d6;
                font-size: 9px;
                letter-spacing: 2px;
                font-style: normal;
                text-align: right;
                margin-top: 4px;
            }

            .raceday-navbar .nav-link {
                color: #dce5f2 !important;
                font-weight: 600;
                padding: 12px 15px !important;
                transition: .2s;
            }

                .raceday-navbar .nav-link:hover,
                .raceday-navbar .nav-link:focus {
                    color: var(--race-orange) !important;
                }

            .raceday-navbar .navbar-toggler {
                border-color: #65738a;
            }

            .raceday-navbar .navbar-toggler-icon {
                filter: brightness(0) invert(1);
            }

            /* ACCOUNT MENU */

            .raceday-avatar {
                width: 39px;
                height: 39px;
                border-radius: 50%;
                object-fit: cover;
                border: 2px solid var(--race-orange);
            }

            .raceday-avatar-fallback {
                width: 39px;
                height: 39px;
                border-radius: 50%;
                background: var(--race-orange);
                color: white;
                display: none;
                align-items: center;
                justify-content: center;
                font-weight: bold;
                font-size: 17px;
            }

            .raceday-account {
                color: white;
                display: flex;
                align-items: center;
                gap: 9px;
                text-decoration: none;
                padding: 6px 12px;
                border: 1px solid #34445d;
                border-radius: 30px;
                transition: .2s;
            }

                .raceday-account:hover {
                    background: var(--race-blue);
                    color: white;
                    border-color: var(--race-orange);
                }

            .raceday-dropdown {
                border: 1px solid #263851;
                border-radius: 12px;
                padding: 9px;
                background: #101d32;
                box-shadow: 0 8px 25px rgba(0,0,0,.4);
            }

                .raceday-dropdown .dropdown-item {
                    color: #e8edf5;
                    padding: 9px 12px;
                    border-radius: 7px;
                }

                    .raceday-dropdown .dropdown-item:hover {
                        background: #213450;
                        color: var(--race-orange);
                    }

                .raceday-dropdown .dropdown-item-text {
                    color: #aab6c8 !important;
                }

            /* BUTTONS */

            .btn-raceday {
                background: var(--race-orange);
                color: #071225;
                border: 1px solid var(--race-orange);
                font-weight: 800;
                border-radius: 30px;
                padding: 10px 21px;
                transition: .2s;
            }

                .btn-raceday:hover {
                    background: var(--race-orange-light);
                    border-color: var(--race-orange-light);
                    color: #071225;
                    transform: translateY(-2px);
                }

            .btn-raceday-outline {
                background: transparent;
                color: white;
                border: 1px solid var(--race-orange);
                border-radius: 30px;
                padding: 10px 21px;
                font-weight: 700;
            }

                .btn-raceday-outline:hover {
                    background: var(--race-orange);
                    color: #071225;
                }

            /* PAGE AND FOOTER */

            main {
                flex: 1;
                padding-bottom: 35px;
            }

            .raceday-footer {
                background: #030914;
                color: #aab6c8;
                padding: 22px 10px;
                margin-top: 35px;
                border-top: 1px solid #253650;
            }

                .raceday-footer p {
                    margin: 0;
                    font-size: 13px;
                    letter-spacing: 1px;
                }

                .raceday-footer span {
                    color: var(--race-orange);
                    font-weight: 700;
                }

            /* RESPONSIVE */

            @@media (max-width: 991px) {
                .raceday-account {
                    margin-top: 12px;
                }

                .navbar-brand {
                    font-size: 22px;
                }

                .raceday-r {
                    font-size: 32px;
                }

                .raceday-navbar .nav-link {
                    padding: 9px 5px !important;
                }
            }
    </style>
</head>

<body>

    <nav class="navbar navbar-expand-lg navbar-dark raceday-navbar">
        <div class="container">

            <a class="navbar-brand"
               asp-controller="@(userRole == "Organiser" ? "Organiser" : userRole == "Participant" ? "Participant" : "Account")"
               asp-action="Index">

                <span class="raceday-symbol">
                    <span class="raceday-checker"></span>
                    <span class="raceday-r">R</span>
                </span>

                <span class="raceday-wordmark">
                    RACE<span>DAY</span>
                    <small class="raceday-tagline">EVERY SECOND COUNTS.</small>
                </span>
            </a>

            <button class="navbar-toggler" type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#racedayNav"
                    aria-controls="racedayNav"
                    aria-expanded="false"
                    aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="racedayNav">

                <ul class="navbar-nav ms-auto align-items-lg-center">

                    @if (userRole == "Organiser")
                    {
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Organiser"
                               asp-action="Index">Dashboard</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Events"
                               asp-action="Index">Events</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Categories"
                               asp-action="Index">Categories</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Enrolments"
                               asp-action="Index">Enrolments</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Results"
                               asp-action="Index">Results</a>
                        </li>
                    }
                    else if (userRole == "Participant")
                    {
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Participant"
                               asp-action="Index">Dashboard</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Events"
                               asp-action="Browse">Browse Events</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="ParticipantEnrollments"
                               asp-action="Index">My Enrolments</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Participant"
                               asp-action="Results">My Results</a>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Account"
                               asp-action="Login">Login</a>
                        </li>
                    }

                    @if (isLoggedIn)
                    {
                        <li class="nav-item dropdown ms-lg-3">

                            <a class="raceday-account dropdown-toggle"
                               href="#"
                               role="button"
                               data-bs-toggle="dropdown"
                               aria-expanded="false">

                                <img src="@Url.Action("Picture", "Profile")"
                                     alt="Profile picture"
                                     class="raceday-avatar"
                                     onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />

                                <span class="raceday-avatar-fallback">
                                    @userInitial
                                </span>

                                <span>@userName</span>
                            </a>

                            <ul class="dropdown-menu dropdown-menu-end raceday-dropdown">

                                <li>
                                    <span class="dropdown-item-text small">
                                        Logged in as @userRole
                                    </span>
                                </li>

                                <li>
                                    <a class="dropdown-item"
                                       asp-controller="Profile"
                                       asp-action="Index">
                                        My Profile
                                    </a>
                                </li>

                                <li><hr class="dropdown-divider" /></li>

                                <li>
                                    <form asp-controller="Account"
                                          asp-action="Logout"
                                          method="post">

                                        @Html.AntiForgeryToken()

                                        <button type="submit"
                                                class="dropdown-item text-danger">
                                            Logout
                                        </button>
                                    </form>
                                </li>

                            </ul>
                        </li>
                    }

                </ul>
            </div>
        </div>
    </nav>

    <main>
        @RenderBody()
    </main>

    <footer class="text-center raceday-footer">
        <p>© 2026 <span>RACEDAY</span> | EVERY SECOND COUNTS.</p>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
