@{
    ViewData["Title"] = "Organiser Dashboard";
}

<div class="container mt-4">

    <h2 class="mb-2">Organiser Dashboard</h2>
    <p class="text-muted">Welcome to RaceDay Event Management.</p>

    <hr />

    <div class="row g-4">

        <div class="col-md-4">
            <div class="card shadow-sm p-3">
                <h4>Manage Events</h4>
                <p>Create, update and manage your sporting events.</p>
                <a href="#" class="btn btn-primary">View Events</a>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm p-3">
                <h4>Categories</h4>
                <p>Manage age groups and event distances.</p>
                <a href="#" class="btn btn-primary">View Categories</a>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm p-3">
                <h4>Enrolments</h4>
                <p>View participants registered for your events.</p>
                <a href="#" class="btn btn-primary">View Enrolments</a>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm p-3">
                <h4>Results</h4>
                <p>Record finishing times and race positions.</p>
                <a href="#" class="btn btn-primary">Manage Results</a>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm p-3">
                <h4>Profile</h4>
                <p>View and update your organiser information.</p>
                <a href="#" class="btn btn-primary">My Profile</a>
            </div>
        </div>

    </div>

</div>
