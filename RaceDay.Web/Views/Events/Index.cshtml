@model List<RaceDay.Web.Models.EventViewModel>

@{
    ViewData["Title"] = "Manage Events";
}

<div class="container mt-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-2">Manage Events</h2>
            <p class="text-muted mb-0">
                View and manage your sporting events.
            </p>
        </div>

        <a asp-controller="Events"
           asp-action="Create"
           class="btn btn-primary">
            + Create Event
        </a>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            No events are currently available.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover shadow-sm">

                <thead class="table-dark">
                    <tr>
                        <th>Event Name</th>
                        <th>Date</th>
                        <th>Time</th>
                        <th>Location</th>
                        <th>Entry Fee</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var raceEvent in Model)
                    {
                        <tr>
                            <td>@raceEvent.EventName</td>
                            <td>@raceEvent.EventDate.ToShortDateString()</td>
                            <td>@raceEvent.EventTime</td>
                            <td>@raceEvent.Location</td>
                            <td>R @raceEvent.EntryFee.ToString("N2")</td>
                            <td>@raceEvent.Status</td>
                            <td>
                                <a asp-controller="Events"
                                   asp-action="Edit"
                                   asp-route-id="@raceEvent.EventID"
                                   class="btn btn-sm btn-primary">
                                    Edit
                                </a>

                                <form asp-controller="Events"
                                      asp-action="Delete"
                                      asp-route-id="@raceEvent.EventID"
                                      method="post"
                                      class="d-inline"
                                      onsubmit="return confirm('Are you sure you want to delete this event?');">

                                    @Html.AntiForgeryToken()

                                    <button type="submit" class="btn btn-sm btn-danger">
                                        Delete
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>

            </table>
        </div>
    }

    <a asp-controller="Organiser"
       asp-action="Index"
       class="btn btn-secondary mt-3">
        Back to Dashboard
    </a>

</div>
