@model RaceDay.Web.Models.EventViewModel

@{
    ViewData["Title"] = "Event Details";
}

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-body p-4">
            <h2>@Model.EventName</h2>
            <p>@Model.EventDescription</p>

            <hr />

            <p>
                <strong>Date:</strong>
                @Model.EventDate.ToString("dd MMMM yyyy")
            </p>

            <p><strong>Time:</strong> @Model.EventTime</p>
            <p><strong>Location:</strong> @Model.Location</p>
            <p>
                <strong>Entry Fee:</strong>
                R @Model.EntryFee.ToString("0.00")
            </p>
            <p>
                <strong>Maximum Participants:</strong>
                @Model.MaxParticipants
            </p>
            <p><strong>Status:</strong> @Model.Status</p>

            <a asp-action="Browse"
               class="btn btn-secondary">
                Back to Events
            </a>
        </div>
    </div>
</div>
