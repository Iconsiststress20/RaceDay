@model RaceDay.Web.Models.ParticipantEnrollmentViewModel

@{
    ViewData["Title"] = "Enrol in Event";
}

<div class="container mt-4">
    <div class="card shadow-sm p-4">
        <h2>Enrol in Event</h2>

        <h5>@Model.EventName</h5>

        <form asp-action="Enrol" method="post">
            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="EventID" />
            <input type="hidden" asp-for="EventName" />

            <div class="mb-3">
                <label asp-for="CategoryID"
                       class="form-label">
                    Select Race Category
                </label>

                <select asp-for="CategoryID"
                        asp-items="Model.Categories"
                        class="form-select">
                    <option value="">Choose a category</option>
                </select>

                <span asp-validation-for="CategoryID"
                      class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">
                Confirm Enrolment
            </button>

            <a asp-controller="Events"
               asp-action="Browse"
               class="btn btn-secondary">
                Cancel
            </a>
        </form>
    </div>
</div>
