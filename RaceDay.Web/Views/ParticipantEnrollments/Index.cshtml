@model List<RaceDay.Web.Models.MyEnrollmentViewModel>

@{
    ViewData["Title"] = "My Enrolments";
}

<div class="container mt-4">
    <h2>My Enrolments</h2>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">
            @ViewBag.Error
        </div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            You have not enrolled in any events yet.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-bordered">
                <thead>
                    <tr>
                        <th>Event</th>
                        <th>Date</th>
                        <th>Location</th>
                        <th>Category</th>
                        <th>Race Number</th>
                        <th>Registration</th>
                        <th>Payment</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.EventName</td>
                            <td>@item.EventDate.ToString("dd MMM yyyy")</td>
                            <td>@item.Location</td>
                            <td>@item.CategoryName (@item.DistanceKM KM)</td>
                            <td>@(item.RaceNumber?.ToString() ?? "Not assigned")</td>
                            <td>@item.Status</td>
                            <td>@item.PaymentStatus</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <a asp-controller="Participant"
       asp-action="Index"
       class="btn btn-secondary">
        Back to Dashboard
    </a>
</div>
