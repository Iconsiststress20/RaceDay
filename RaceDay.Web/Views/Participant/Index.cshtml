@{
    ViewData["Title"] = "Participant Dashboard";
}

<div class="container mt-5">

    <div class="mb-5">
        <h2 class="fw-bold">Participant Dashboard</h2>
        <p class="text-muted">
            Discover events, challenge yourself and track your progress.
        </p>
    </div>

    <div class="row g-4">

        <div class="col-md-4">
            <div class="card shadow-sm p-4 h-100">
                <h4>🏁 Browse Events</h4>
                <p>Discover upcoming running, walking and cycling events.</p>
                <a href="#" class="btn btn-primary mt-auto">Explore Events</a>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm p-4 h-100">
                <h4>📋 My Enrolments</h4>
                <p>View the events and categories you have entered.</p>
                <a href="#" class="btn btn-primary mt-auto">My Enrolments</a>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm p-4 h-100">
                <h4>🏆 My Results</h4>
                <p>Check your finishing times and race positions.</p>
                <a href="#" class="btn btn-primary mt-auto">View Results</a>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm p-4 h-100">
                <h4>👤 My Profile</h4>
                <p>View and update your personal information.</p>
                <a href="#" class="btn btn-primary mt-auto">My Profile</a>
            </div>
        </div>

    </div>

    <form asp-controller="Account" asp-action="Logout"
          method="post" class="mt-5">

        @Html.AntiForgeryToken()

        <button type="submit" class="btn btn-danger">
            Logout
        </button>

    </form>

</div>
