@model List<RaceDay.Web.Models.EnrolmentViewModel>

@{
    ViewData["Title"] = "Manage Enrolments";
}

<div class="container mt-4">

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Manage Enrolments</h2>
            <p class="text-muted">
                View participants enrolled in your events.
            </p>
        </div>

        <a asp-controller="Organiser"
           asp-action="Index"
           class="btn btn-secondary">
            Back to Dashboard
        </a>
    </div>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">
            @ViewBag.Error
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-body">

            <h5 class="mb-3">
                Enrolment Records (@Model.Count)
            </h5>

            @if (Model.Count == 0)
            {
                <div class="alert alert-info">
                    There are currently no enrolments for your events.
                </div>
            }
            else
            {

                <div class="table-responsive">
                    <table class="table table-striped table-hover align-middle">

                        <thead class="table-dark">
                            <tr>
                                <th>Participant</th>
                                <th>Contact</th>
                                <th>Event</th>
                                <th>Event Date</th>
                                <th>Category</th>
                                <th>Enrolled</th>
                                <th>Status</th>
                                <th>Payment</th>
                                <th>Race Number</th>
                                <th>Action</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var enrolment in Model)
                            {
                                var formId = $"update-{enrolment.EnrollmentID}";

                                <tr>
                                    <td>
                                        <strong>@enrolment.ParticipantName</strong>
                                        <br />
                                        <small class="text-muted">
                                            ID: @enrolment.ParticipantID
                                        </small>
                                    </td>

                                    <td>
                                        @enrolment.Email
                                        <br />
                                        <small class="text-muted">
                                            @enrolment.PhoneNumber
                                        </small>
                                    </td>

                                    <td>@enrolment.EventName</td>

                                    <td>
                                        @enrolment.EventDate.ToString("dd MMM yyyy")
                                    </td>

                                    <td>
                                        @enrolment.CategoryName
                                        <br />
                                        <small class="text-muted">
                                            @enrolment.DistanceKM km
                                        </small>
                                    </td>

                                    <td>
                                        @enrolment.EnrollmentDate.ToString("dd MMM yyyy")
                                    </td>

                                    <td>
                                        <select name="Status"
                                                form="@formId"
                                                class="form-select">
                                            @foreach (var status in new[]
                                            {
                                "Registered", "Approved", "Rejected", "Cancelled"
                            })
                                            {
                                                if (enrolment.Status == status)
                                                {
                                                    <option value="@status" selected>@status</option>
                                                }
                                                else
                                                {
                                                    <option value="@status">@status</option>
                                                }
                                            }
                                        </select>
                                    </td>

                                    <td>
                                        <select name="PaymentStatus"
                                                form="@formId"
                                                class="form-select">
                                            @foreach (var payment in new[]
                                            {
                                "Pending", "Paid", "Unpaid"
                            })
                                            {
                                                if (enrolment.PaymentStatus == payment)
                                                {
                                                    <option value="@payment" selected>@payment</option>
                                                }
                                                else
                                                {
                                                    <option value="@payment">@payment</option>
                                                }
                                            }
                                        </select>
                                    </td>

                                    <td>
                                        <input type="number"
                                               name="RaceNumber"
                                               form="@formId"
                                               class="form-control"
                                               min="1"
                                               value="@enrolment.RaceNumber" />
                                    </td>

                                    <td>
                                        <form id="@formId"
                                              asp-controller="Enrolments"
                                              asp-action="Update"
                                              asp-route-id="@enrolment.EnrollmentID"
                                              method="post">
                                            <button type="submit"
                                                    class="btn btn-primary btn-sm">
                                                Save
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>

                    </table>
                </div>

            }

        </div>
    </div>
</div>
